menu "Pointing Options"

# Deprecated old config, kept for backwards compat
config ZMK_MOUSE
    bool "(Deprecated) Mouse Support"

config ZMK_POINTING
    bool "Pointing Device Support"
    default y if ZMK_MOUSE
    select INPUT
    select INPUT_THREAD_PRIORITY_OVERRIDE

if ZMK_POINTING

# Needed for anyone using gpio-keys for things like soft-off setup.
config INPUT_GPIO_KEYS
    default n

config INPUT_THREAD_STACK_SIZE
    default 1024 if ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL

if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_POINTING_SMOOTH_SCROLLING
    bool "Smooth Scrolling"
    help
      Enable smooth scrolling, with hosts that support HID Resolution Multipliers

config ZMK_INPUT_LISTENER
    bool "Input listener for processing input events in the system"
    default y
    depends on DT_HAS_ZMK_INPUT_LISTENER_ENABLED


config ZMK_INPUT_PROCESSOR_TEMP_LAYER
    bool "Temporary Layer Input Processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_TEMP_LAYER_ENABLED

config ZMK_INPUT_PROCESSOR_TEMP_LAYER_MAX_ACTION_EVENTS
    int "Temporary Layer Input Processor Max Action Events"
    default 4
    depends on ZMK_INPUT_PROCESSOR_TEMP_LAYER

config ZMK_INPUT_PROCESSOR_TEMP_LAYER_STUCK_RECOVERY
    bool "Temporary Layer stuck recovery watchdog"
    depends on ZMK_INPUT_PROCESSOR_TEMP_LAYER
    help
      Add a delayed recovery check for temporary layers that remain active far
      longer than their normal dwell timeout. This is intended to recover from
      a lost/deferred deactivate work item without changing normal layer use.

config ZMK_INPUT_PROCESSOR_TEMP_LAYER_STUCK_TIMEOUT_MS
    int "Temporary Layer stuck recovery timeout in milliseconds"
    default 30000
    depends on ZMK_INPUT_PROCESSOR_TEMP_LAYER_STUCK_RECOVERY
    help
      If the temporary layer is still active after this much time without
      renewed pointing/excluded-key activity, force a layer deactivation.

config ZMK_INPUT_PROCESSOR_TEMP_LAYER_STUCK_REBOOT
    bool "Reboot after temporary layer stuck recovery"
    depends on ZMK_INPUT_PROCESSOR_TEMP_LAYER_STUCK_RECOVERY
    select REBOOT
    help
      Reboot the central MCU after the forced layer deactivation. Use this only
      when the real-world failure is known to recover from a central-side power
      cycle or reboot.

config ZMK_INPUT_PROCESSOR_TEMP_LAYER_STUDIO_RPC
    bool "AML Studio RPC (live config via ZMK Studio)"
    depends on ZMK_INPUT_PROCESSOR_TEMP_LAYER
    select SETTINGS
    help
      Expose AutoMouse Layer config (deactivation timeout, prior-idle guard,
      excluded key positions) via a custom Studio RPC subsystem "pyuron_aml".
      Requires the ZMK fork with custom-studio-protocol support.
      Changes are persisted to NVS and survive reboot.

# ---- AML config seed (version-gated) -------------------------------------
# ソース側に「シード値＋バージョン番号」を持たせ、起動時に
#   ソースの SEED_VERSION > NVS に記録済みの取り込み済みバージョン
# のときだけシード値を NVS に書き込む。同じか古ければ何もしない
# (ライブ調整値を温存)。default 0 = シードしない(現状の NVS を一切触らない)。
if ZMK_INPUT_PROCESSOR_TEMP_LAYER_STUDIO_RPC

config PYURON_AML_SEED_VERSION
    int "AML seed version (0 = never seed)"
    default 0
    help
      ソースが持つ AML シード設定のバージョン番号。起動時に NVS に記録された
      取り込み済みバージョンより大きいときだけ、下記の SEED_* 値を NVS へ
      取り込む(1度だけ)。0 のままならシードは走らず、既存の NVS 値
      (ライブ調整値)は一切変更されない(非破壊・出荷時デフォルト)。
      新しいシード値を反映させたいときだけ、この番号を 1 ずつ増やす。

config PYURON_AML_SEED_DEACTIVATION_MS
    int "AML seed: deactivation_ms (-1 = leave unchanged)"
    default -1
    help
      シード時に書き込む AML 滞在時間(ms)。-1(既定)は「未指定」とみなし、その
      項目は据え置く(既存値/param2 由来の既定を温存)。0 以上は明示値として焼く。

config PYURON_AML_SEED_PRIOR_IDLE_MS
    int "AML seed: prior_idle_ms (-1 = leave unchanged)"
    default -1
    help
      シード時に書き込む AML 発火ガード(ms)。-1(既定)は「未指定」=据え置き。
      0 は有効値(ガードなし=いつでも入る)として焼けるよう、印は -1 を使う。

config PYURON_AML_SEED_EXTEND_MS
    int "AML seed: extend_ms (-1 = leave unchanged)"
    default -1
    help
      シード時に書き込む除外キー延長(ms)。-1(既定)は「未指定」=据え置き。
      0 は有効値(延長しない)として焼けるよう、印は -1 を使う。

config PYURON_AML_SEED_EXCLUDED
    string "AML seed: excluded positions (space-separated, empty = leave unchanged)"
    default ""
    help
      シード時に書き込む除外キー位置の配列。"12 34 56" のように空白区切りで
      位置番号を並べる。空文字は「未指定」とみなし、除外リストは据え置く。
      AML_MAX_EXCLUDED(=16) を超える分・範囲外は無視する。

endif # ZMK_INPUT_PROCESSOR_TEMP_LAYER_STUDIO_RPC

config ZMK_INPUT_PROCESSOR_PYURON_SCROLL_INVERT
    bool "Pyuron scroll-direction inverter input processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_PYURON_SCROLL_INVERT_ENABLED

config PYURON_SCROLL_STUDIO_RPC
    bool "Pyuron scroll-invert Studio RPC (live toggle via ZMK Studio)"
    depends on ZMK_INPUT_PROCESSOR_PYURON_SCROLL_INVERT
    select SETTINGS
    help
      Expose scroll-direction inversion flags (invert_v / invert_h) via a
      custom Studio RPC subsystem "pyuron_scroll".  Lets the ZMK Studio app
      toggle Win/Mac natural-scroll direction at runtime without reflashing.
      Requires the ZMK fork with custom-studio-protocol support.
      Changes are persisted to NVS and survive reboot.

config ZMK_INPUT_PROCESSOR_PYURON_SPEED
    bool "Pyuron trackball speed-multiplier input processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_PYURON_SPEED_ENABLED

config PYURON_SPEED_STUDIO_RPC
    bool "Pyuron trackball speed Studio RPC (live % adjust via ZMK Studio)"
    depends on ZMK_INPUT_PROCESSOR_PYURON_SPEED
    select SETTINGS
    help
      Expose the trackball cursor speed multiplier (percent, 100 = x1.0) via a
      custom Studio RPC subsystem "pyuron_speed".  Gives smooth cursor-speed
      control between the sensor's coarse 200-CPI hardware steps, without
      reflashing.  Changes are persisted to NVS and survive reboot.

endif

config ZMK_INPUT_PROCESSOR_TRANSFORM
    bool "Transform Input Processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_TRANSFORM_ENABLED

config ZMK_INPUT_PROCESSOR_SCALER
    bool "Scaling Input Processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_SCALER_ENABLED

config ZMK_INPUT_PROCESSOR_CODE_MAPPER
    bool "Code Mapper Input Processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_CODE_MAPPER_ENABLED

config ZMK_INPUT_PROCESSOR_BEHAVIORS
    bool "Behaviors Input Processor"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_BEHAVIORS_ENABLED

config ZMK_INPUT_SPLIT
    bool "Split input support"
    default y
    depends on DT_HAS_ZMK_INPUT_SPLIT_ENABLED && ZMK_SPLIT

if ZMK_INPUT_SPLIT

config ZMK_INPUT_SPLIT_INIT_PRIORITY
    int "Input Split initialization priority"
    default INPUT_INIT_PRIORITY


config ZMK_INPUT_SPLIT_MAX_TRACKED_KEYS
    int "Input Split max tracked keys to release on peripheral disconnect"
    default 5

endif # ZMK_INPUT_SPLIT

endif # ZMK_POINTING

endmenu # Mouse Options
